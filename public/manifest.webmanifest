{
  "id": "/",
  "name": "Linked",
  "short_name": "Linked",
  "description": "Save links from your phone and open them on your desktop.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f7f7f7",
  "theme_color": "#000000",
  "prefer_related_applications": false,
  "icons": [
    { "src": "/icons/arrow-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/arrow-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "share_target": {
    "action": "/share",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
